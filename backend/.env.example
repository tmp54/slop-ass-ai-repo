# Copy to .env (never commit .env).
DATABASE_URL=sqlite:///./handoff.db
# Comma-separated origins allowed by CORS (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
# Read-only GitHub token used by the AI pipeline to fetch PR/issue content.
GITHUB_TOKEN=
# AI pipeline implementation as module:Class.
AI_PIPELINE=app.ai.stub:StubPipeline
# Anthropic key for the real AI pipeline (unused by the stub).
ANTHROPIC_API_KEY=
# Optional overrides for app.ai.pipeline:Pipeline (defaults shown).
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_TOKENS=4096
